rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos (Build Order step 9a / User Profile System) - each
    // user can only write into their own folder. Reads are open to any
    // signed-in user since photos are shown to opponents during the
    // pre-match bio reveal and (for approved profiles) more broadly.
    // Acceptance into profile.photoUrls only happens after the
    // moderatePhoto Cloud Function approves the image - see
    // functions/visualModeration.js - so a photo landing in Storage does
    // NOT by itself mean it's live on a profile.
    // Raw match recordings (Agora Cloud Recording writes here directly,
    // using its own HMAC credentials - which bypass these rules entirely,
    // exactly like the Admin SDK does).
    //
    // Denied to clients in BOTH directions, deliberately:
    //  - No client writes: nothing in the app uploads footage, so any
    //    write here would be forged.
    //  - No client reads: this is raw, unreviewed footage of two people,
    //    retained for at most 7 days. CLAUDE.md requires human review
    //    before any clip reaches an audience, and a readable path would
    //    route around that gate entirely - anyone who could guess a match
    //    id could pull unreviewed video of strangers.
    // Published highlights will be served from their own reviewed
    // location, not from here.
    match /match_recordings/{matchId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Rendered highlight clips (functions/highlightRender.js). Written by
    // the renderMatchHighlight Cloud Function via the Admin SDK, which
    // bypasses these rules.
    //
    // Denied to clients for the same reason as the raw footage above, and
    // it matters just as much here: a rendered clip is watchable, which
    // makes it far more attractive to leak than raw HLS, and it is still
    // UNREVIEWED. `highlight.reviewStatus` starts at "pending" and a human
    // has to approve a clip before it reaches any audience. A readable
    // path would route straight around that gate.
    //
    // Approved clips get distributed by being posted to the website or
    // social accounts, not by opening this bucket path up.
    match /match_highlights/{matchId}/{allPaths=**} {
      // Rendered clips are readable by any SIGNED-IN user, so battles can
      // actually be watched and judged inside the app.
      //
      // This is a deliberate loosening. It used to deny everyone, because
      // a render is unreviewed - no human has looked at it. But keeping it
      // shut meant every ranked match needed a manual approval inside its
      // 24-hour voting window or it closed unwatched, which does not scale
      // past one person, and judging a battle you cannot watch is not
      // judging at all.
      //
      // What makes it acceptable is who is on the other side of this rule:
      // signed-in accounts only, all age-gated to 18+ at signup, all having
      // consented to the mature-content terms, with a report button on the
      // same screen as the video and a 24-hour commitment to act on reports
      // (Apple Guideline 1.2). That is the standard posture for
      // user-generated content - you do not pre-moderate every item, you
      // make every item reportable.
      //
      // The human review gate has NOT gone away, it has moved to where the
      // non-consenting audience actually is: publishHighlight still governs
      // external posting to the website and social, and nothing reaches a
      // public URL without an admin approving it.
      //
      // Writes stay closed: only the render pipeline (Admin SDK, which
      // bypasses these rules) ever puts a file here.
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /profile_photos/{userId}/{photoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
