rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Rating/rank fields are sensitive per CLAUDE.md's Security &
      // Compliance Baseline - a modified client must not be able to fake
      // wins or grant itself rank. Only the castVote Cloud Function's
      // finalizeMatch (Admin SDK, bypasses these rules entirely) may ever
      // change them after account creation. create requires the exact
      // starting defaults; update requires those five fields to be
      // unchanged from their current values.
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.rating == 1200 &&
        request.resource.data.rankTitle == 'Average Joe' &&
        request.resource.data.rankedMatchesPlayed == 0 &&
        request.resource.data.wins == 0 &&
        request.resource.data.losses == 0 &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.isAdmin == false &&
        // The username is NOT written here. Signup creates this document
        // without one and then calls setUsername, which is the only thing
        // that filters and claims a name. Allowing it at create would
        // leave the filter bypassable at the exact moment it matters
        // most - the moment the name is chosen.
        !('username' in request.resource.data) &&
        !('usernameLower' in request.resource.data) &&
        // NOTHING THAT GRANTS ANYTHING MAY BE SEEDED HERE.
        //
        // The update rule below freezes these fields by requiring them
        // to be unchanged - but that only protects a value that was
        // never forged in the first place. Without this, a modified
        // client could create its own user document at signup with
        // `subscription.active: true`, a million points, or a full day
        // of judging it never did, and the update rule would then hold
        // those forged values in place permanently. Immutable-but-
        // attacker-chosen is strictly worse than mutable.
        //
        // Verified against signup_screen.dart, which writes only rating,
        // rankTitle, rankedMatchesPlayed, wins, losses, accountStatus,
        // isAdmin and createdAt - so forbidding all of these costs a
        // real signup nothing.
        !request.resource.data.keys().hasAny([
          'subscription', 'points', 'pointsBalance', 'freeClipUsed',
          'clipCredits', 'dayPassExpiresAtMs', 'dailyAwards',
          'judgeVotesToday', 'judgeDayKey', 'judgeCalls',
          'careerRankedMatches', 'skipsUsedToday', 'skipsResetDate',
          'takedowns', 'lastNotifiedRankTitle', 'lastSeenRankTitle',
          'dailyReward', 'followerCount', 'lastSeenFameMilestone',
          'emojiCounts', 'votesCast', 'emojiTopAwards', 'emojiScrub',
          'tournamentWins',
        ]);

      // Uses .get(field, default) rather than direct field access - a
      // direct `resource.data.rating` on a doc missing that key throws a
      // rules evaluation error (not just a false condition), which denies
      // the ENTIRE update, including otherwise-unrelated fields like
      // `profile`. Confirmed live: a legacy test account created before
      // these fields existed in the signup flow got permission-denied on
      // every single profile save, with no way to self-heal client-side,
      // until the doc was manually backfilled. Real users should always
      // have these fields (signup_screen.dart sets them atomically at
      // creation), but rules shouldn't hard-fail an unrelated write just
      // because some other migration gap left a doc mid-shape.
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('rating', null) == resource.data.get('rating', null) &&
        request.resource.data.get('rankTitle', null) == resource.data.get('rankTitle', null) &&
        request.resource.data.get('rankedMatchesPlayed', null) == resource.data.get('rankedMatchesPlayed', null) &&
        request.resource.data.get('wins', null) == resource.data.get('wins', null) &&
        request.resource.data.get('losses', null) == resource.data.get('losses', null) &&
        // accountStatus (active/banned/flagged) must be just as protected -
        // otherwise a banned client could simply write itself back to
        // 'active' and bypass the ban entirely. Only admin action via the
        // Firebase console (Admin SDK, bypasses these rules) may change it.
        request.resource.data.get('accountStatus', null) == resource.data.get('accountStatus', null) &&
        // Same reasoning for isAdmin - otherwise any client could grant
        // itself access to the debug*/admin-gated Cloud Functions below.
        request.resource.data.get('isAdmin', null) == resource.data.get('isAdmin', null) &&
        // The daily skip allowance (CLAUDE.md's skip/decline decision) is
        // only meaningful if the client can't reset its own counter -
        // otherwise a modified client has unlimited skips and can
        // cherry-pick easy opponents all day, which is the exact behaviour
        // the limit exists to prevent. Written only by the skipMatch Cloud
        // Function. Neither field exists at signup, so the .get(_, null)
        // form matters here as much as it does above.
        request.resource.data.get('skipsUsedToday', null) == resource.data.get('skipsUsedToday', null) &&
        request.resource.data.get('skipsResetDate', null) == resource.data.get('skipsResetDate', null) &&
        // Judge record: how often this user's call matched the crowd. It
        // feeds a prestige ladder, so a client able to write it could
        // simply declare itself an infallible judge. Written only by
        // recordCalls, which checks every call against the match's actual
        // recorded winner.
        request.resource.data.get('judgeCalls', null) == resource.data.get('judgeCalls', null) &&
        // How much this account judged today, and the day that count
        // belongs to. A client able to write these mints itself the
        // maximum earned skips and the maximum matchmaking head start
        // without judging anything - which defeats the whole point of
        // the skip ceiling, since skips are worth MORE to a rating
        // manipulator than to an honest player. Written only by
        // castVote, inside the transaction that records the vote.
        request.resource.data.get('judgeVotesToday', null) ==
          resource.data.get('judgeVotesToday', null) &&
        request.resource.data.get('judgeDayKey', null) ==
          resource.data.get('judgeDayKey', null) &&
        // The career match count, which survives a season reset and is
        // what the entitlement carve-out reads to decide who counts as
        // a genuinely new player. A client able to zero it would grant
        // itself Practice during Sixes and Sevens forever, when that
        // hour is deliberately ranked-only for everyone including
        // subscribers.
        request.resource.data.get('careerRankedMatches', null) ==
          resource.data.get('careerRankedMatches', null) &&
        // Monthly takedown allowance, for the same reason the skip counter
        // is protected: a client that could reset it would have unlimited
        // opt-outs, which is precisely what the published cap prevents.
        request.resource.data.get('takedowns', null) == resource.data.get('takedowns', null) &&
        // The points balance. Same class of write as rating and wins: a
        // client able to set its own balance could buy every cosmetic in
        // the store outright. Written only by awardPoints, which credits
        // it inside a transaction alongside a ledger entry so the same
        // event can never pay twice.
        request.resource.data.get('points', null) == resource.data.get('points', null) &&
        // The SPENDABLE balance, protected separately because it is now
        // the one points actually buy things with - a client able to set
        // it could mint itself unlimited captioned clips, which cost real
        // transcription money. `points` above stays the career total and
        // only ever rises; this is what spending draws down.
        request.resource.data.get('pointsBalance', null) ==
          resource.data.get('pointsBalance', null) &&
        // Subscription state decides who battles outside Sixes and Sevens
        // and who gets clips included - a client that could write it would
        // simply grant itself the paid tier.
        request.resource.data.get('subscription', null) ==
          resource.data.get('subscription', null) &&
        // The one-free-clip flag, and any clip credits owed. Captions cost
        // real transcription money per clip, so a client that could reset
        // either would mint them without limit - the same class of write
        // as pointsBalance, and cheaper to abuse since it needs no points
        // at all. Written only by requestMatchClip and refundClipGrants.
        request.resource.data.get('freeClipUsed', null) ==
          resource.data.get('freeClipUsed', null) &&
        // The day pass expiry, and the per-day award counters behind the
        // vote cap. A client that could write the first would grant itself
        // a permanent free subscription; one that could reset the second
        // would restore its vote-points allowance at will and farm the
        // currency that BUYS the pass. Two halves of the same hole.
        request.resource.data.get('dayPassExpiresAtMs', null) ==
          resource.data.get('dayPassExpiresAtMs', null) &&
        request.resource.data.get('dailyAwards', null) ==
          resource.data.get('dailyAwards', null) &&
        // The daily-login-reward cycle state (last claim day + cycle day). A
        // client that could rewind lastClaimDay would re-claim the reward
        // any number of times a day, minting the currency the claim mints.
        // Written only by claimDailyReward.
        request.resource.data.get('dailyReward', null) ==
          resource.data.get('dailyReward', null) &&
        // The fame follower count, and the last fame milestone the player
        // has been shown a popup for. followerCount is maintained by the
        // onFollow* triggers and drives the public Fame board, so a client
        // able to write it could put itself at the top of that board and
        // fake the "roadmap to fame" outright. lastSeenFameMilestone is
        // written by getPendingFameMilestone; a client that could rewind it
        // would replay the milestone popup forever.
        request.resource.data.get('followerCount', null) ==
          resource.data.get('followerCount', null) &&
        request.resource.data.get('lastSeenFameMilestone', null) ==
          resource.data.get('lastSeenFameMilestone', null) &&
        // When they last voted, which enforces the minimum gap between
        // votes. A client that could rewind it would vote as fast as it
        // liked, which is the exact behaviour the gap exists to price up.
        request.resource.data.get('lastVoteAtMs', null) ==
          resource.data.get('lastVoteAtMs', null) &&
        // The voter's lifetime "battles judged" total, incremented once per
        // match by castVote (Admin SDK) and shown on their profile. A client
        // able to write it could inflate its own judged count - harmless to
        // others, but it is a public identity number, so it stays server-only.
        request.resource.data.get('votesCast', null) ==
          resource.data.get('votesCast', null) &&
        // Lifetime tournaments won, incremented only by the onTournamentCompleted
        // trigger (Admin SDK) when a tournament crowns this player. It drives a
        // permanent "Tournament Champion" award badge, so a client able to write
        // it could hand itself the badge without ever winning.
        request.resource.data.get('tournamentWins', null) ==
          resource.data.get('tournamentWins', null) &&
        // Per-player emoji ratings (🔥/🧠/🥱/💩), tallied only by castVote via
        // the Admin SDK as ballots come in. These are a player's public
        // identity - profile flair, badges, the Hottest board, their
        // nickname - so a client able to write them could crown itself.
        request.resource.data.get('emojiCounts', null) ==
          resource.data.get('emojiCounts', null) &&
        // The permanent "ever been #1 in an emoji" awards, stamped only by the
        // awardEmojiTopAwards sweep (Admin SDK). Derived from emojiCounts, so
        // a client able to write them could crown itself The Inferno / Biggest
        // Shit Bag without ever topping the board.
        request.resource.data.get('emojiTopAwards', null) ==
          resource.data.get('emojiTopAwards', null) &&
        // The daily emoji-cleanup counter ({day, count}), written only by
        // scrubEmojiRating. A client that could reset it would bypass the daily
        // cap and scrub its negative counts without limit - buying a clean
        // public identity, which the cap exists to prevent.
        request.resource.data.get('emojiScrub', null) ==
          resource.data.get('emojiScrub', null) &&
        request.resource.data.get('clipCredits', null) ==
          resource.data.get('clipCredits', null) &&
        // The username, and its lowercased search copy. Written only by
        // setUsername, which filters it, claims it for uniqueness and
        // enforces the change cooldown.
        //
        // A client that could write this directly would route around all
        // three at once: it could put a slur on the public leaderboard
        // and the website (which is why the filter exists at all - see
        // functions/username.js), it could take a name already claimed by
        // someone else and make two accounts indistinguishable, and it
        // could rename itself hourly to shake off recognition after a bad
        // match, which is precisely what the cooldown prevents.
        request.resource.data.get('username', null) ==
          resource.data.get('username', null) &&
        request.resource.data.get('usernameLower', null) ==
          resource.data.get('usernameLower', null) &&
        request.resource.data.get('usernameChangedAt', null) ==
          resource.data.get('usernameChangedAt', null);

      allow delete: if false;

      // The audit trail behind the balance: one entry per award, at a
      // deterministic id, which is what makes awarding idempotent - a
      // retried vote or a match settled twice finds its entry already
      // there and pays nothing.
      //
      // Readable by its owner so "where did these points come from" has an
      // answer in the app. Written only by awardPoints; a client able to
      // write here could mint entries and inflate its own balance.
      match /pointsLedger/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Rating history: one entry per rated match, written inside the same
      // transaction that changes the rating. Readable by its owner so a
      // player can see their own form; never client-writable, for exactly
      // the reason `rating` itself is not - a forgeable history would make
      // any stat built on it meaningless.
      match /ratingHistory/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Friend-battle challenges. Written only by the challengeFriend and
    // respondToChallenge Cloud Functions.
    //
    // Closed to clients in both directions. Writable would let anyone
    // forge a challenge from someone else, or mark their own accepted and
    // conjure a match. Readable is barely better: a challenge names two
    // people who wanted to battle each other, and blocking is deliberately
    // silent - a readable collection would let a blocked person see that
    // their challenges exist but are never delivered, which is exactly
    // what the silence protects against. getMyChallenges serves each side
    // only what is theirs.
    match /challenges/{challengeId} {
      allow read, write: if false;
    }

    // Fame follows: one document per (target, follower) pair, marking that
    // `followerUid` follows `targetUid`. Own-write only - a client can make
    // ITSELF follow or unfollow someone, and nothing more, so at worst one
    // account adds one follower to a target. That is the same threat model
    // as the live watcher count (own-write, vanity), and it is why the Fame
    // board carries NO rewards in V1: with nothing to win, there is little
    // reason to farm follows, and a farmed follow that never watches adds no
    // real crowd anyway. The authoritative followerCount is maintained by a
    // Cloud Function trigger (not writable here), so it cannot be inflated
    // beyond one-per-account through this path.
    //
    // Read is restricted to the follower's own membership doc, which is all
    // the client needs to render its Follow state; the public follower
    // COUNT is exposed through users.followerCount, not by reading the list.
    // Self-follow is refused.
    match /follows/{targetUid}/followers/{followerUid} {
      allow read: if request.auth != null && request.auth.uid == followerUid;
      allow create: if request.auth != null &&
        request.auth.uid == followerUid && followerUid != targetUid;
      allow delete: if request.auth != null && request.auth.uid == followerUid;
      allow update: if false;
    }

    // Username claims, one document per lowercased name, holding the uid
    // that owns it. This collection IS the uniqueness guarantee: setUsername
    // claims and releases inside a transaction, which is the only way two
    // people submitting the same name in the same second can be resolved.
    //
    // Closed to clients entirely. Writable would obviously defeat it; even
    // readable is pointless here, since it is a complete name-to-account
    // map and the player directory already answers the only legitimate
    // question ("does this person exist") under its own visibility rules.
    match /usernames/{usernameKey} {
      allow read, write: if false;
    }

    // Live match configuration (CLAUDE.md's config/matchSettings): round
    // count, turn length, countdown, bio-reveal length, plus per-mode
    // overrides. Edited by hand in the Firebase console, which is the
    // same admin workflow used for profile approval, report review and
    // tournament creation.
    //
    // Readable so a client could show the values, but NOT the source of
    // truth for a match in progress: the settings that actually govern a
    // match are resolved server-side at pairing time and stamped onto the
    // match document, so both players run identical timings even if the
    // config changes mid-match. Writes are console-only - a client that
    // could edit this would set its own turn length.
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Aggregate, non-identifying counts - currently just how many people
    // are queueing or mid-match, for the "N roasters online now" counter.
    // Readable by any signed-in client because that number is the whole
    // point; written only by the scheduled publishOnlineCount function,
    // since a client that could write it could fake a busy app.
    match /stats/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Live-match spectator heartbeats, powering the "N watching" count on the
    // live viewer. A signed-in viewer may READ the count and write ONLY their
    // own heartbeat doc (uid == userId), so the number reflects distinct
    // accounts and cannot be inflated by writing other people's docs. Purely
    // ephemeral/vanity - no sensitive fields, and nothing downstream trusts it
    // for rating, money, or moderation. Stale docs (a viewer who left) are
    // simply not counted (the client filters by a fresh lastSeenMs).
    match /liveWatch/{matchId}/viewers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /matches/{matchId} {
      // Match documents are now created and settled entirely server-side:
      // pollMatchmaking creates them at pairing time and completeMatch
      // marks them finished (functions/matchmaking.js), both via the Admin
      // SDK, which bypasses these rules. Clients have no reason to write
      // here at all any more.
      //
      // This is stricter than it was, deliberately. When the two
      // participants wrote the document themselves, a modified client
      // could name any two players it wanted and declare the match
      // finished - which is the entry point to the voting pipeline and,
      // for ranked matches, to real Elo changes. That's the same class of
      // sensitive write as rating/points per CLAUDE.md's Security &
      // Compliance Baseline, so it belongs behind a Cloud Function.
      allow read: if request.auth != null;
      allow write: if false;

      // The running head-to-head score, powering the live scoreboard.
      //
      // Kept in its own document rather than on the match specifically so
      // it can be gated differently: the match itself must be readable by
      // everyone for the feed, but seeing who is AHEAD before you vote
      // biases your vote, and it would tell someone rallying support
      // exactly how many more ballots they still need.
      //
      // So it is readable if you have ALREADY cast your ballot on this
      // match - your vote is in, there is nothing left to bias - or if you
      // are one of the two players. Participants cannot vote on their own
      // match at all, so there is no vote of theirs left to influence, and
      // watching your own result come in live is the entire point of the
      // feature.
      //
      // Written only by the onVoteCast trigger via the Admin SDK.

      // The freeform per-clip emoji "reactions" were retired (developer's
      // call, 2026-09-23) in favour of the per-player emoji RATING cast with
      // each ballot (see castVote and users.emojiCounts). Clients no longer
      // write here, so no rule is needed.

      match /tally/{document} {
        allow read: if request.auth != null && (
          exists(/databases/$(database)/documents/votes/$(matchId)/ballots/$(request.auth.uid)) ||
          request.auth.uid ==
            get(/databases/$(database)/documents/matches/$(matchId)).data.player1Id ||
          request.auth.uid ==
            get(/databases/$(database)/documents/matches/$(matchId)).data.player2Id
        );
        allow write: if false;
      }
    }

    // A vote session: one CAPTCHA solve buying a bounded run of votes, so
    // the feed doesn't put a checkbox between every battle.
    //
    // WRITES ARE THE WHOLE POINT OF THIS RULE. The document holds the
    // remaining vote budget and the expiry - a client able to write its own
    // would simply mint an unlimited, never-expiring session and skip the
    // CAPTCHA entirely, which is the one thing this mechanism exists to
    // prevent. Only startVoteSession and castVote touch it, via the Admin
    // SDK, which bypasses these rules.
    //
    // Reading your own is allowed so the client can re-challenge BEFORE a
    // vote is refused rather than after, and it reveals nothing but how
    // many votes you have left.
    match /voteSessions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /votes/{matchId}/ballots/{voterId} {
      // Votes ONLY go through the castVote Cloud Function (CAPTCHA
      // verification, 24h window, one-vote-per-account, and account-age
      // vote-weight all need server-side enforcement - see functions/index.js
      // and CLAUDE.md's Judging / CAPTCHA-gate notes).
      //
      // You may read your OWN ballot and nobody else's. This used to be
      // open to any signed-in user so the client could add the ballots up
      // itself, which is now exactly the wrong shape: the running score is
      // deliberately hidden until you have voted (see the tally rule
      // above), and readable ballots let any client sum them and see the
      // score anyway - the gate would be decoration. Ballots also name who
      // voted for whom, which is the raw material for coordinating a
      // brigade.
      //
      // Reading your own is still allowed because the client legitimately
      // needs to know whether you have already judged this match, and it
      // reveals nothing you did not do yourself.
      allow read: if request.auth != null && request.auth.uid == voterId;
      allow write: if false;
    }

    match /tournaments/{tournamentId} {
      // Creation and bracket generation/advancement only happen via Admin
      // SDK (Firebase console for creation, Cloud Functions for the
      // bracket - see functions/tournament.js and CLAUDE.md's Admin/
      // moderation tooling notes, which use the console rather than a
      // custom admin UI for V1). No entry fee is actually collected from
      // clients yet (see CLAUDE.md's step 8 status note), so there's no
      // client-side reason to write here at all.
      allow read: if request.auth != null;
      allow write: if false;

      match /entrants/{userId} {
        // Joining/withdrawing is free in V1 (no payment processor - see
        // CLAUDE.md's step 8 status note), so these write directly from
        // the client, gated on the parent tournament still being open.
        // Withdrawal-before-start is CLAUDE.md's explicit tournament
        // withdrawal decision; once bracket generation flips status away
        // from 'open', both creating and deleting an entrant doc stop
        // being allowed.
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status == 'open';
        allow delete: if request.auth != null && request.auth.uid == userId &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status == 'open';
        allow update: if false;
      }
    }

    match /reports/{reportId} {
      // In-app report button (Build Order step 9). Reporter picks a
      // category (CLAUDE.md's Report categories decision) - reason must be
      // one of the fixed set, not free text, so the console review queue
      // stays sortable/filterable. Reviewed the SAME way as profile
      // approval and tournament creation: the Firebase console, not a
      // custom admin UI - so there's no client read rule at all, and only
      // the Admin SDK (bypasses these rules) ever sets moderatorNotes or
      // changes status away from 'pending'.
      allow read: if false;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.reporterId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason in
          ['harassment', 'hate_speech', 'technical_quality', 'inappropriate_content', 'impersonation'];
      allow update, delete: if false;
    }

    match /banAppeals/{appealId} {
      // CLAUDE.md's Ban appeal decision: banned users get a simple way to
      // contest the decision, reviewed via the console like everything
      // else admin-side. A banned account can still call `create` here
      // even though its own users/{uid} doc is otherwise locked down -
      // the appeal collection is intentionally separate from users/{uid}
      // so submitting one doesn't require any permission the ban itself
      // would remove.
      allow read: if false;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /supportRequests/{requestId} {
      // In-app support/contact form (Build Order step 9b, CLAUDE.md's
      // Support & Launch Strategy decision - satisfies app-store listing
      // requirements for a support contact). Same "console review queue,
      // no custom admin UI, no client read" pattern as reports/banAppeals.
      allow read: if false;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.category in
          // No refund category, deliberately: nothing in the app takes
          // money yet, and once subscriptions ship the stores process
          // refunds rather than us. Older requests that used it are
          // unaffected - this only validates new writes.
          ['general_question', 'bug_report', 'account_issue', 'other'];
      allow update, delete: if false;
    }
  }
}
